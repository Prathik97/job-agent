<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.prathikkumar.jobagent.daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__PROJECT_DIR__/scheduler/run_daily.sh</string>
    </array>
    <!-- 8:30 AM in the Mac's local time zone (IST on this Mac). If the Mac is asleep, it runs on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <!-- Output goes to data/clean/scheduler.log (gitignored). Keys are redacted from log lines. -->
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/data/clean/scheduler.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/data/clean/scheduler.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
